# Required runtime
DATABASE_URL=
CRON_SECRET=

# Optional Awin product feed
AWIN_DATAFEED_API_KEY=

# Recommended remote browser fallback for JS-rendered / blocked shops
# Create a Browserless Cloud key and set it as a Vercel Production secret.
BROWSERLESS_API_TOKEN=
# Defaults to the EU/Amsterdam Browserless Cloud region.
BROWSERLESS_BASE_URL=https://production-ams.browserless.io
# true by default; uses /unblock for direct 403/429 and as secondary fallback.
BROWSERLESS_UNBLOCK=true
# Optional: residential or datacenter. Leave empty initially to avoid extra proxy units.
BROWSERLESS_PROXY=
# Limit browser calls per failed source. Default: 2, max: 3.
BROWSER_FALLBACK_URL_LIMIT=2

# Legacy compatibility only; if set, this complete endpoint takes precedence over the token settings above.
BROWSERLESS_CONTENT_URL=
